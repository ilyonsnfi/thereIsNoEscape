{
  "manifest_version": 3,
  "name": "Halo Esc Key Blocker",
  "version": "0.2",
  "description": "Stops halopsa.com capturing the Esc key, and adds keyboard shortcuts for ticket actions",
  "content_scripts": [
    {
      "matches": [
        "*://*.halopsa.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.halopsa.com/*"
      ],
      "js": [
        "shortcuts.js",
        "hotkeys.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Halo Esc Key Blocker"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ]
}
